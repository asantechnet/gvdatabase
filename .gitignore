# Prevent accidental vue-tsc/tsc output from shadowing TypeScript/Vue sources
resources/ts/**/*.vue.js
resources/ts/**/*.vue.js.map
resources/ts/**/*.js.map
resources/ts/**/*.jsx.map
/vite.config.js
/vite.config.js.map
/themeConfig.js
/themeConfig.js.map

# Ignore MSW script
public/mockServiceWorker.js

